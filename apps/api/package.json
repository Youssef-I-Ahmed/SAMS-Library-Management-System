{
  "name": "@sams/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch src/server.js",
    "start": "dotenv -e ../../.env -- node src/server.js",
    "build": "node -e \"console.log('API is plain Node.js ESM; no build step required')\"",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=../../prisma/schema.prisma",
    "prisma:seed": "dotenv -e ../../.env -- node ../../prisma/seed.js",
    "test": "dotenv -e ../../.env -- vitest run",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "dotenv-cli": "^8.0.0",
    "vitest": "^2.1.8",
    "supertest": "^7.0.0"
  }
}
