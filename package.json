{
  "name": "sams-library-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @sams/web",
    "dev:api": "npm run dev -w @sams/api",
    "build": "npm run build -w @sams/web && npm run build -w @sams/api",
    "db:generate": "npm run prisma:generate -w @sams/api",
    "db:migrate": "npm run prisma:migrate -w @sams/api",
    "db:seed": "npm run prisma:seed -w @sams/api",
    "test": "npm run test -w @sams/api && npm run test:web",
    "db:validate": "npm run prisma:validate -w @sams/api",
    "test:api": "npm run test -w @sams/api",
    "test:web": "node --test apps/web/tests/i18n.test.mjs apps/web/tests/ai-controller.test.mjs apps/web/tests/discovery-navigation.test.mjs apps/web/tests/book-cover-pilot.test.mjs",
    "setup": "node scripts/dev/setup.mjs",
    "dev": "node scripts/dev/dev.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
