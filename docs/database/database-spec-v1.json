{
  "project": "SAMS Library Management System",
  "version": "1.0",
  "status": "draft-baseline",
  "database": "PostgreSQL",
  "orm": "Prisma",
  "architecture": {
    "multiBranch": true,
    "centralized": true,
    "webBased": true,
    "legacyMigration": true,
    "analyticsReady": true
  },
  "enums": {
    "item_type": [
      "BOOK",
      "THESIS",
      "PROJECT"
    ],
    "academic_status": [
      "ACTIVE",
      "GRADUATED",
      "SUSPENDED",
      "INACTIVE"
    ],
    "contributor_role": [
      "AUTHOR",
      "RESEARCHER",
      "SUPERVISOR",
      "PROJECT_MEMBER"
    ],
    "copy_status": [
      "AVAILABLE",
      "RESERVED",
      "BORROWED",
      "UNAVAILABLE",
      "DAMAGED",
      "LOST",
      "ARCHIVED"
    ],
    "copy_condition": [
      "GOOD",
      "FAIR",
      "DAMAGED"
    ],
    "reservation_status": [
      "PENDING",
      "ACTIVE",
      "FULFILLED",
      "CANCELLED",
      "EXPIRED"
    ],
    "borrowing_status": [
      "ACTIVE",
      "RETURNED",
      "LOST"
    ],
    "visit_source": [
      "MANUAL",
      "BARCODE",
      "QR"
    ]
  },
  "tables": {
    "users": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "university_email": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        },
        "external_auth_id": {
          "type": "varchar",
          "nullable": true,
          "unique": true
        },
        "display_name": {
          "type": "varchar",
          "nullable": false
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      }
    },
    "roles": {
      "columns": {
        "id": {
          "type": "smallint",
          "pk": true,
          "nullable": false
        },
        "name": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        }
      },
      "seed": [
        "STUDENT",
        "LIBRARIAN",
        "MANAGEMENT"
      ]
    },
    "user_roles": {
      "columns": {
        "user_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "users.id"
        },
        "role_id": {
          "type": "smallint",
          "nullable": false,
          "fk": "roles.id"
        }
      },
      "primaryKey": [
        "user_id",
        "role_id"
      ]
    },
    "faculties": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "name": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        }
      }
    },
    "departments": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "faculty_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "faculties.id"
        },
        "name": {
          "type": "varchar",
          "nullable": false
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        }
      },
      "unique": [
