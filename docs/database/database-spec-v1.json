        "reservation_hold_hours": {
          "type": "integer",
          "nullable": false,
          "min": 0
        },
        "max_active_loans": {
          "type": "integer",
          "nullable": false,
          "min": 0
        },
        "max_active_reservations": {
          "type": "integer",
