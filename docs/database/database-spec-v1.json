        "effective_to": {
          "type": "date",
          "nullable": true
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        }
      }
    },
    "audit_logs": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "actor_user_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "users.id"
        },
        "action": {
          "type": "varchar",
          "nullable": false
        },
        "entity_type": {
          "type": "varchar",
          "nullable": false
        },
        "entity_id": {
          "type": "varchar",
          "nullable": true
        },
        "branch_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "branches.id"
        },
        "old_values": {
          "type": "jsonb",
          "nullable": true
        },
        "new_values": {
          "type": "jsonb",
          "nullable": true
        },
        "metadata": {
          "type": "jsonb",
          "nullable": true
        },
        "request_id": {
          "type": "uuid",
          "nullable": true
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        }
      },
      "appendOnly": true,
      "forbiddenSecrets": [
        "passwords",
        "access_tokens",
        "refresh_tokens",
        "otp_codes",
        "authentication_secrets"
      ]
    },
    "idempotency_records": {
      "recommended": true,
      "columns": {
        "key": {
          "type": "varchar",
          "pk": true,
          "nullable": false
        },
        "user_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "users.id"
        },
        "operation": {
          "type": "varchar",
          "nullable": false
        },
        "result_reference": {
          "type": "varchar",
          "nullable": true
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "expires_at": {
          "type": "timestamptz",
          "nullable": false
        }
      }
    }
  },
  "concurrency": {
    "defaultIsolation": "READ COMMITTED",
    "reservationAllocation": [
      "transaction",
      "SELECT ... FOR UPDATE SKIP LOCKED",
      "partial unique index"
    ],
    "borrowing": [
      "transaction",
      "row lock",
      "one active borrowing per copy"
    ],
    "return": [
      "transaction",
      "borrow/ copy row locks",
      "idempotent state check"
    ],
    "adminEditing": [
      "optimistic locking using version"
    ],
    "duplicateRequests": [
      "idempotency keys"
    ]
  },
  "plannedViews": [
    "v_item_availability",
    "v_current_borrowings",
    "v_overdue_borrowings",
    "v_active_reservations",
    "v_monthly_library_visits",
    "v_borrowings_by_item",
    "v_borrowings_by_category",
    "v_branch_activity"
  ],
  "legacyMigration": {
    "preserveRawValues": true,
    "callNumberExample": "658.3 / ا.م",
    "expectedFiles": [
      ".exe",
      ".dll",
      ".mdb",
      ".accdb",
      ".db",
      ".dbf",
      ".dat",
      ".ini",
      ".cfg",
      ".xml",
      ".bak"
    ],
    "separatePCDatasets": true
  },
  "tbc": [
    "phase 1 branch scope",
    "university SSO provider",
    "student database integration method",
    "reservation duration",
    "maximum active reservations",
    "maximum active loans",
    "loan duration by item type",
    "renewals",
    "reservation queue for already-borrowed items",
    "thesis/project borrowability",
    "visitor checkout requirement",
    "lost/damaged/fines process",
    "exact legacy call-number convention"
  ]
}