          "faculty_id",
          "name"
        ]
      ]
    },
    "students": {
      "columns": {
        "user_id": {
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "fk": "users.id"
        },
        "student_id": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        },
        "faculty_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "faculties.id"
        },
        "department_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "departments.id"
        },
        "academic_status": {
          "type": "academic_status",
          "nullable": false,
          "default": "ACTIVE"
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      }
    },
    "branches": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "code": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        },
        "name": {
          "type": "varchar",
          "nullable": false
        },
        "location": {
          "type": "varchar",
          "nullable": true
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        },
        "version": {
          "type": "integer",
          "nullable": false,
          "default": 1
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      }
    },
    "categories": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "name": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        },
        "description": {
          "type": "text",
          "nullable": true
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        }
      }
    },
    "dewey_classifications": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "code": {
          "type": "varchar",
          "nullable": false,
          "unique": true
        },
        "name": {
          "type": "varchar",
          "nullable": true
        },
        "parent_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "dewey_classifications.id"
        }
      }
    },
    "library_items": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "type": {
          "type": "item_type",
          "nullable": false
        },
        "title": {
          "type": "varchar",
          "nullable": false
        },
        "category_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "categories.id"
        },
        "dewey_classification_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "dewey_classifications.id"
        },
        "dewey_code_raw": {
          "type": "varchar",
          "nullable": true
        },
        "call_number": {
          "type": "varchar",
          "nullable": true
        },
        "language": {
          "type": "varchar",
          "nullable": true
        },
        "publication_year": {
          "type": "smallint",
          "nullable": true
        },
        "abstract_description": {
          "type": "text",
          "nullable": true
        },
        "is_active": {
          "type": "boolean",
          "nullable": false,
          "default": true
        },
        "version": {
          "type": "integer",
          "nullable": false,
          "default": 1
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      }
    },
    "book_details": {
      "columns": {
        "item_id": {
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "fk": "library_items.id"
        },
        "isbn": {
          "type": "varchar",
          "nullable": true
        },
        "publisher": {
          "type": "varchar",
          "nullable": true
        },
        "edition": {
          "type": "varchar",
          "nullable": true
        }
      }
    },
    "academic_work_details": {
      "columns": {
        "item_id": {
          "type": "uuid",
          "pk": true,
          "nullable": false,
          "fk": "library_items.id"
        },
        "faculty_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "faculties.id"
        },
        "department_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "departments.id"
        },
        "academic_year": {
          "type": "varchar",
          "nullable": true
        },
        "work_type": {
          "type": "item_type",
          "nullable": false,
          "allowed": [
            "THESIS",
            "PROJECT"
          ]
        }
      }
    },
    "contributors": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "full_name": {
          "type": "varchar",
          "nullable": false
        }
      }
    },
    "item_contributors": {
      "columns": {
        "item_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "library_items.id"
        },
        "contributor_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "contributors.id"
        },
        "role": {
          "type": "contributor_role",
          "nullable": false
        }
      },
      "primaryKey": [
        "item_id",
        "contributor_id",
        "role"
      ]
    },
    "physical_copies": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "item_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "library_items.id"
        },
        "branch_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "branches.id"
        },
        "copy_code": {
          "type": "varchar",
          "nullable": true
        },
        "barcode": {
          "type": "varchar",
          "nullable": true,
          "unique": true
        },
        "shelf_location": {
          "type": "varchar",
          "nullable": true
        },
        "status": {
          "type": "copy_status",
          "nullable": false,
          "default": "AVAILABLE"
        },
        "condition": {
          "type": "copy_condition",
          "nullable": true
        },
        "version": {
          "type": "integer",
          "nullable": false,
          "default": 1
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      }
    },
    "reservations": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "student_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "students.user_id"
        },
        "item_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "library_items.id"
        },
        "branch_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "branches.id"
        },
        "allocated_copy_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "physical_copies.id"
        },
        "status": {
          "type": "reservation_status",
          "nullable": false
        },
        "reserved_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "expires_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "fulfilled_at": {
          "type": "timestamptz",
          "nullable": true
        },
        "cancelled_at": {
          "type": "timestamptz",
          "nullable": true
        },
        "cancelled_by_user_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "users.id"
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      },
      "partialUnique": [
        {
          "columns": [
            "student_id",
            "item_id"
          ],
          "where": "status IN ('PENDING','ACTIVE')"
        }
      ]
    },
    "borrowings": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "student_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "students.user_id"
        },
        "copy_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "physical_copies.id"
        },
        "branch_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "branches.id"
        },
        "reservation_id": {
          "type": "uuid",
          "nullable": true,
          "fk": "reservations.id"
        },
        "borrowed_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "due_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "returned_at": {
          "type": "timestamptz",
          "nullable": true
        },
        "checked_out_by": {
          "type": "uuid",
          "nullable": false,
          "fk": "users.id"
        },
        "returned_by": {
          "type": "uuid",
          "nullable": true,
          "fk": "users.id"
        },
        "status": {
          "type": "borrowing_status",
          "nullable": false,
          "default": "ACTIVE"
        },
        "return_condition": {
          "type": "varchar",
          "nullable": true
        },
        "notes": {
          "type": "text",
          "nullable": true
        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      },
      "partialUnique": [
        {
          "columns": [
            "copy_id"
          ],
          "where": "status = 'ACTIVE'"
        }
      ],
      "derived": {
        "overdue": "returned_at IS NULL AND due_at < NOW()"
      }
    },
    "library_visits": {
      "columns": {
        "id": {
          "type": "uuid",
          "pk": true,
          "nullable": false
        },
        "student_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "students.user_id"
        },
        "branch_id": {
          "type": "uuid",
          "nullable": false,
          "fk": "branches.id"
        },
        "checked_in_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "checked_out_at": {
          "type": "timestamptz",
          "nullable": true
        },
        "registered_by": {
          "type": "uuid",
          "nullable": false,
          "fk": "users.id"
        },
        "checkout_by": {
          "type": "uuid",
          "nullable": true,
          "fk": "users.id"
        },
        "source": {
          "type": "visit_source",
          "nullable": false,
