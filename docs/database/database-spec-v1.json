        },
        "created_at": {
          "type": "timestamptz",
          "nullable": false
        },
        "updated_at": {
          "type": "timestamptz",
          "nullable": false
        }
      },
      "partialUnique": [
        {
          "columns": [
            "student_id"
          ],
          "where": "checked_out_at IS NULL"
        }
      ]
    },
    "circulation_policies": {
      "columns": {
