# Streamlit Community Cloud -> your app -> Settings -> Secrets: paste this block and replace the placeholders.
# NEVER commit the real values. (.streamlit/secrets.toml is git-ignored.)

# ---- access control (REQUIRED for a pilot: the data contains real student and supervisor names)
APP_ACCESS_PASSWORD = "CHANGE-ME-long-random-password"
PILOT_ADMIN_PASSWORD = ""            # empty = admin tab disabled (recommended on the cloud: filesystem is ephemeral)
HIDE_STUDENT_NAMES = "false"         # "true" = demo mode: student names are never shown

# ---- semantic retrieval (torch-free ONNX model, downloaded on first start)
EMBEDDING_BACKEND = "fastembed"
EMBEDDING_MODEL = "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# ---- LLM (leave LLM_PROVIDER = "none" for retrieval-only mode)
LLM_PROVIDER = "gemini"
LLM_MODEL = "auto"        # "auto" = the app asks Google which stable flash model your key can use; or paste an exact id from the status-tab list
LLM_API_KEY = "PASTE-YOUR-GOOGLE-AI-STUDIO-KEY"
RAG_INCLUDE_SUPERVISORS = "false"    # "true" also sends supervisor names to Google inside the prompt (default false: not needed to answer)
RAG_INCLUDE_STUDENTS = "false"       # "true" also sends student names to Google inside the prompt (default false)
