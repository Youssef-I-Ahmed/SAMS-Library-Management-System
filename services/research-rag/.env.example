# =====================================================================================================
# SADAT RAG backend (FastAPI) - copy to .env and fill in. NEVER commit or ship .env (it is git/docker-ignored).
# The backend reads this file automatically at start-up (pydantic-settings); real environment variables win.
# =====================================================================================================

# ---- 1. REQUIRED for the standalone backend --------------------------------------------------------
# Gemini (answer generation only; retrieval, search and every structured answer work without it).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash         # Gemini Interactions API; verified by scripts/gemini_check.py
LLM_API_KEY=                         # the academy Gemini key. Set it ONLY here / in the server's secret store.
# Service-to-service auth: the academy backend signs short-lived HS256 JWTs with this secret (>= 32 chars).
#   generate:  python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_JWT_SECRET=change-me
# Embeddings (separate from the generation model above). Preserved from the approved deployment:
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_CACHE_DIR=data/store/models   # the ~220 MB ONNX model is downloaded once from huggingface.co and kept here
# Privacy (defaults shown; do not enable unless the academy explicitly approves): names never go to Gemini.
RAG_INCLUDE_STUDENTS=false
RAG_INCLUDE_SUPERVISORS=false

# ---- 2. Everything below is optional / has safe defaults (original reference configuration) ----------

# ---- Copy to .env and fill in. NEVER commit .env ----

# Runtime mode: "standalone" (RAG service owns a SQLite/Postgres copy; pilot) or
# "integrated" (PostgreSQL via Prisma is authoritative; admin CRUD here is disabled)
RAG_MODE=standalone

# Database for the RAG service's own tables (records copy + embeddings + audit).
# Pilot: SQLite file. Production: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///data/store/rag.db

# Integrated mode only: read-only connection to the authoritative PostgreSQL + mapping
SOURCE_DATABASE_URL=
SOURCE_TABLE=rag_projects_v   # SQL view agreed with the software team (see docs/INTEGRATION.md)

# Embeddings: "hashing" (offline lexical fallback, no download) or "sentence-transformers"
# EMBEDDING_BACKEND is set in section 1 (hashing = offline lexical fallback)
# EMBEDDING_MODEL is set in section 1
# Real multilingual (neural) search: pip install -r requirements-embeddings.txt, python scripts/download_model.py, then
#   EMBEDDING_BACKEND=sentence-transformers
#   EMBEDDING_MODEL_PATH=models/multilingual-e5-small     # local folder (wins over EMBEDDING_MODEL)
#   EMBEDDING_LOCAL_ONLY=true                             # never contact huggingface.co
# and re-run python scripts/bootstrap.py (re-embeds all records) and python scripts/eval_semantic.py (measure + calibrate).
EMBEDDING_MODEL_PATH=
EMBEDDING_LOCAL_ONLY=false
SEMANTIC_MIN_SCORE=0.30            # cosine floor, hashing embedder
SEMANTIC_MIN_SCORE_NEURAL=0.35     # UNCALIBRATED fallback; scripts/eval_semantic.py writes data/cache/semantic_calibration.json which wins

# LLM provider: none | gemini | openai | anthropic   (openai = any OpenAI-compatible server)
# LLM_PROVIDER: none | ollama (free, local, no key) | gemini | openai (also any OpenAI-compatible server via LLM_BASE_URL) | anthropic
# (LLM_PROVIDER / LLM_MODEL / LLM_API_KEY are set in section 1)
LLM_BASE_URL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Service-to-service auth (Express -> FastAPI). Long random secret, e.g. `openssl rand -hex 32`
# (SERVICE_JWT_SECRET is set in section 1)
SERVICE_JWT_ISSUER=sadat-express
SERVICE_JWT_AUDIENCE=sadat-rag
ADMIN_ROLES=ADMIN,LIBRARIAN

# Streamlit pilot only (not used by the backend): PILOT_ADMIN_PASSWORD, APP_ACCESS_PASSWORD

# Misc
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100
# Optional (dev only): comma-separated browser origins allowed by CORS. Leave empty in production
# (Express -> FastAPI is server-to-server and needs no CORS).
CORS_ORIGINS=
# Send student names to the external LLM provider? Default false (privacy).
# Local development ONLY: disables read auth. Admin endpoints stay locked without a secret.
AUTH_DISABLED=false

# ---- Evidence / abstention policy (see docs/EVIDENCE_POLICY.md)
EVIDENCE_MIN_COVERAGE=0.67
EVIDENCE_COMMON_TERM_DF=0.08
EVIDENCE_ALLOW_SEMANTIC_ONLY=false
EVIDENCE_MIN_SUPPORTED_RECORDS=1
EVIDENCE_SIMILAR_TITLE_RATIO=88

# --- free local models through Ollama (see docs/FREE_LOCAL_TESTING.md) ---
# EMBEDDING_BACKEND=ollama        # EMBEDDING_MODEL=bge-m3 (multilingual)
# LLM_PROVIDER=ollama             # LLM_MODEL=qwen2.5:3b  LLM_TIMEOUT_S=240
OLLAMA_URL=http://localhost:11434
LLM_NUM_CTX=8192

# ---- Streamlit Cloud pilot (see docs/STREAMLIT_CLOUD_GUIDE.md)
# EMBEDDING_BACKEND=fastembed   (torch-free ONNX; EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2)
HIDE_STUDENT_NAMES=false
