# Server process environment only. No real credentials or private keys here.
BOOK_RAG_SOURCE=postgres
# Docker uses this fixed alias on an internal-only bridge; no public/LAN DB hosts.
BOOK_RAG_CONTAINER=1
BOOK_RAG_PGHOST=postgres
BOOK_RAG_PGPORT=5432
BOOK_RAG_PGDATABASE=sams_library
BOOK_RAG_PGUSER=sams_book_rag_ro
BOOK_RAG_PGPASSWORD=
BOOK_RAG_MAP_PATH=
BOOK_RAG_MAP_SHA256=
BOOK_RAG_SOURCE_SHA256=
BOOK_RAG_REFRESH_SECONDS=5
BOOK_RAG_MAX_STALE_SECONDS=30
LLM_PROVIDER=extractive
SAMS_MODELS_DIR=
SAMS_STORE_DIR=
API_SERVICE_KEY=
API_ALLOWED_ORIGINS=
API_UNLIMITED_ROLES=
# Host-side read-only mounts (never browser variables or image build arguments).
BOOK_RAG_MODELS_HOST_PATH=
BOOK_RAG_MAP_HOST_PATH=
