# PostgreSQL
# Project Docker development mapping: host 5433 -> container 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sams_library?schema=public"

# API
API_PORT=4000
NODE_ENV="development"
WEB_ORIGIN="http://localhost:5173"
API_JSON_LIMIT="2mb"
REQUEST_LOGGING="true"
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# Authentication
# Development only. Production startup must explicitly set this to false.
DEV_AUTH_ENABLED="true"

# Use a unique secret. Minimum 32 chars in development, 48 chars in production.
AUTH_TOKEN_SECRET="replace-this-with-a-long-development-secret"
AUTH_TOKEN_EXPIRES_IN="8h"

# AI gateway: disabled by default; ignored optional settings while disabled.
# Server only. Never put these in VITE_* variables or frontend code.
AI_ENABLED=false
RAG_URL=
RAG_SERVICE_KEY=
AI_BOOK_CODE_MAP_PATH=
AI_BOOK_CODE_MAP_SHA256=
AI_SOURCE_SHA256=
AI_SERVICE_EPOCH=
AI_ASK_TIMEOUT_MS=15000
AI_CARD_TIMEOUT_MS=5000
AI_RESET_TIMEOUT_MS=5000
AI_HEALTH_TIMEOUT_MS=2000
AI_POLL_TIMEOUT_MARGIN_MS=5000
AI_REQUEST_MAX_BYTES=8192
AI_RESPONSE_MAX_BYTES=2097152
AI_POLL_WINDOW_MS=240000

# Existing legacy codes remain pinned; PostgreSQL-native codes also require active BOOK/BookDetails.
AI_BOOK_IDENTITY_MODE=legacy

# Optional server-only connection for the view-only sams_research_rag_ro role.
RESEARCH_RAG_DATABASE_URL=
