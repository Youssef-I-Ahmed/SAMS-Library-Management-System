# PostgreSQL
# Project Docker development mapping: host 5433 -> container 5432.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/sams_library?schema=public"

# API
API_PORT=4000
NODE_ENV="development"
WEB_ORIGIN="http://localhost:5173"
API_JSON_LIMIT="2mb"
REQUEST_LOGGING="true"
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# Authentication
# Development only. Production startup must explicitly set this to false.
DEV_AUTH_ENABLED="true"
# Optional local presentation account snapshots; enabled by scripts/Start-Local.ps1.
# Requires development mode. Ordinary API startup keeps live authentication checks.
DEMO_AUTH_ENABLED="false"

# Use a unique secret. Minimum 32 chars in development, 48 chars in production.
AUTH_TOKEN_SECRET="replace-this-with-a-long-development-secret"
AUTH_TOKEN_EXPIRES_IN="8h"

# AI gateway: disabled by default; ignored optional settings while disabled.
# Server only. Never put these in VITE_* variables or frontend code.
AI_ENABLED=false
RAG_URL=
RAG_SERVICE_KEY=
AI_BOOK_CODE_MAP_PATH=
AI_BOOK_CODE_MAP_SHA256=
AI_SOURCE_SHA256=
AI_SERVICE_EPOCH=
AI_ASK_TIMEOUT_MS=15000
AI_CARD_TIMEOUT_MS=5000
AI_RESET_TIMEOUT_MS=5000
AI_HEALTH_TIMEOUT_MS=2000
AI_POLL_TIMEOUT_MARGIN_MS=5000
AI_REQUEST_MAX_BYTES=8192
AI_RESPONSE_MAX_BYTES=2097152
AI_POLL_WINDOW_MS=240000

# Existing legacy codes remain pinned; PostgreSQL-native codes also require active BOOK/BookDetails.
AI_BOOK_IDENTITY_MODE=legacy

# Optional server-only connection for the view-only sams_research_rag_ro role.
RESEARCH_RAG_DATABASE_URL=

# ---------------------------------------------------------------------------
# AI services (services/*). Each one is optional: leave its URL empty to disable it.
# `npm run dev` starts every service whose URL is set and whose .venv exists
# (created by `npm run setup`). Keys/secrets are generated by `npm run setup`.

# services/book-rag (port 8001). RAG_URL and RAG_SERVICE_KEY above point to it;
# book-rag also needs its own services/book-rag/.env (models dir, catalog source).

# services/research-rag (port 8002): ranks projects; replies stay SAMS catalog rows.
RESEARCH_RAG_URL=
RESEARCH_RAG_JWT_SECRET=

# services/subject-classifier (port 8003) and services/book-clustering (port 8004):
# staff-only cataloguing suggestions at /api/v1/ai/classify-subject and /book-cluster.
SUBJECT_CLASSIFIER_URL=http://127.0.0.1:8003
SUBJECT_CLASSIFIER_KEY=
BOOK_CLUSTERING_URL=http://127.0.0.1:8004
BOOK_CLUSTERING_KEY=
